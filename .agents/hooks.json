{
  "grafoparada-auto-guard": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python hooks/agent_guard.py pre_invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/agent_guard.py pre_tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/agent_guard.py post_edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
